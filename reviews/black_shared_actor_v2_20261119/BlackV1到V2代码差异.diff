+def _prefix_memory(count, max_controls):
+  """按有限episode与10Hz相机估算CPU峰值，开采样前拦截明显内存不足。"""
+  max_frames = (max_controls + CAMERA_INTERVAL_CONTROLS - 1) // CAMERA_INTERVAL_CONTROLS
